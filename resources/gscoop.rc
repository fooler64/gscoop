#include <windows.h>

// 可执行文件图标（资源管理器/任务栏显示）
IDI_ICON1 ICON "gscoop.ico"

// 版本信息
VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "gScoop contributors\0"
            VALUE "FileDescription",  "gScoop - Scoop package manager GUI (Ganyu theme)\0"
            VALUE "FileVersion",      "0.1.0\0"
            VALUE "InternalName",     "gscoop\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 gScoop contributors. LGPL-3.0-or-later\0"
            VALUE "OriginalFilename", "gscoop.exe\0"
            VALUE "ProductName",      "gScoop\0"
            VALUE "ProductVersion",   "0.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
